From 006feabb774a40f81c6c4990c7688f66c5c18bf5 Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Tue, 20 Oct 2026 01:38:44 +0300
Subject: [PATCH] [SPIRV] List a shader entry point's interface from its call
 tree

Every OpEntryPoint listed every global variable of the module. With entry
points of several stages in one module, a fragment entry's interface then
held the vertex stage's integer inputs, which Vulkan requires to be Flat in
a fragment shader ("Input interfaces with integer or float type must have a
Flat decoration").

A global's OpVariable is materialised in each function that uses it, so a
shader entry point's interface is now the variables of the functions its
call tree reaches. A kernel keeps every variable, as OpenCL code can reach
a global through another's initializer, which no function's body shows.
---
 llvm/lib/Target/SPIRV/SPIRVAsmPrinter.cpp     | 35 ++++++++++--
 .../SPIRV/entry-point-interface-per-entry.ll  | 53 +++++++++++++++++++
 2 files changed, 85 insertions(+), 3 deletions(-)
 create mode 100644 llvm/test/CodeGen/SPIRV/entry-point-interface-per-entry.ll

diff --git a/llvm/lib/Target/SPIRV/SPIRVAsmPrinter.cpp b/llvm/lib/Target/SPIRV/SPIRVAsmPrinter.cpp
index 11f8674730..fd483f4e26 100644
--- a/llvm/lib/Target/SPIRV/SPIRVAsmPrinter.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVAsmPrinter.cpp
@@ -24,6 +24,8 @@
 #include "SPIRVUtils.h"
 #include "TargetInfo/SPIRVTargetInfo.h"
 #include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/SetVector.h"
+#include "llvm/ADT/SmallPtrSet.h"
 #include "llvm/Analysis/ValueTracking.h"
 #include "llvm/CodeGen/AsmPrinter.h"
 #include "llvm/CodeGen/AsmPrinterAnalysis.h"
@@ -34,6 +36,7 @@
 #include "llvm/CodeGen/MachinePassManager.h"
 #include "llvm/CodeGen/TargetLoweringObjectFileImpl.h"
 #include "llvm/IR/Analysis.h"
+#include "llvm/IR/InstIterator.h"
 #include "llvm/IR/PassManager.h"
 #include "llvm/MC/MCAsmInfo.h"
 #include "llvm/MC/MCAssembler.h"
@@ -409,8 +412,14 @@ void SPIRVAsmPrinter::outputOpMemoryModel() {
 // These declare the set of global variables from a module that form
 // the interface of this entry point.
 void SPIRVAsmPrinter::outputEntryPoints() {
-  // Find all OpVariable IDs with required StorageClass.
+  // Find all OpVariable IDs with required StorageClass. A global's OpVariable
+  // is materialised in every function that uses it, so each is also recorded
+  // with its function: a shader entry point's interface is the variables of
+  // the functions its call tree reaches, not every variable of the module (a
+  // vertex stage's integer input would otherwise sit in a fragment entry's
+  // interface, which Vulkan requires to be Flat).
   DenseSet<MCRegister> InterfaceIDs;
+  DenseMap<const Function *, SmallVector<MCRegister, 8>> UsedBy;
   for (const MachineInstr *MI : MAI->GlobalVarList) {
     assert(MI->getOpcode() == SPIRV::OpVariable ||
            MI->getOpcode() == SPIRV::OpUntypedVariableKHR);
@@ -425,17 +434,37 @@ void SPIRVAsmPrinter::outputEntryPoints() {
       const MachineFunction *MF = MI->getMF();
       MCRegister Reg = MAI->getRegisterAlias(MF, MI->getOperand(0).getReg());
       InterfaceIDs.insert(Reg);
+      UsedBy[&MF->getFunction()].push_back(Reg);
     }
   }
 
-  // Output OpEntryPoints adding interface args to all of them.
+  // Output OpEntryPoints, each with the interface its call tree uses.
   for (const MachineInstr *MI : MAI->getMSInstrs(SPIRV::MB_EntryPoints)) {
     SPIRVMCInstLower MCInstLowering;
     MCInst TmpInst;
     MCInstLowering.lower(MI, TmpInst, MAI);
+    SmallPtrSet<const Function *, 8> Reached;
+    SmallVector<const Function *, 8> Worklist = {&MI->getMF()->getFunction()};
+    while (!Worklist.empty()) {
+      const Function *F = Worklist.pop_back_val();
+      if (!Reached.insert(F).second)
+        continue;
+      for (const Instruction &I : instructions(*F))
+        if (const auto *CB = dyn_cast<CallBase>(&I))
+          if (const Function *Callee = CB->getCalledFunction();
+              Callee && !Callee->isDeclaration())
+            Worklist.push_back(Callee);
+    }
+    SetVector<MCRegister> Used;
+    for (const Function *F : Reached)
+      if (auto It = UsedBy.find(F); It != UsedBy.end())
+        Used.insert_range(It->second);
+    // A kernel keeps every variable: OpenCL code can reach a
+    // global through another's initializer, which no function's body shows.
     for (MCRegister Reg : InterfaceIDs) {
       assert(Reg.isValid());
-      TmpInst.addOperand(MCOperand::createReg(Reg));
+      if (!ST->isShader() || Used.contains(Reg))
+        TmpInst.addOperand(MCOperand::createReg(Reg));
     }
     outputMCInst(TmpInst);
   }
diff --git a/llvm/test/CodeGen/SPIRV/entry-point-interface-per-entry.ll b/llvm/test/CodeGen/SPIRV/entry-point-interface-per-entry.ll
new file mode 100644
index 0000000000..feec2f2850
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/entry-point-interface-per-entry.ll
@@ -0,0 +1,53 @@
+; RUN: llc -O0 -verify-machineinstrs -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - -filetype=obj | spirv-val --target-env vulkan1.3 %}
+
+; An entry point's interface lists the global variables its call tree uses,
+; not every global of the module: a vertex stage's integer input in the
+; fragment entry's interface would need a Flat decoration it cannot have.
+
+; CHECK-DAG: OpEntryPoint Vertex %[[VS:[0-9]+]] "vs" %[[VIDX:[0-9]+]] %[[OUT:[0-9]+]]{{$}}
+; CHECK-DAG: OpEntryPoint Fragment %[[FS:[0-9]+]] "fs" %[[SHARED:[0-9]+]] %[[IN:[0-9]+]] %[[COLOR:[0-9]+]]{{$}}
+; CHECK-DAG: OpName %[[VIDX]] "vidx"
+; CHECK-DAG: OpName %[[OUT]] "out"
+; CHECK-DAG: OpName %[[IN]] "in"
+; CHECK-DAG: OpName %[[COLOR]] "color"
+; CHECK-DAG: OpName %[[SHARED]] "shared"
+
+@vidx = external hidden thread_local addrspace(7) externally_initialized constant i32, !spirv.Decorations !1
+@out = external hidden thread_local addrspace(8) global <4 x float>, !spirv.Decorations !3
+@in = external hidden thread_local addrspace(7) externally_initialized constant <4 x float>, !spirv.Decorations !3
+@color = external hidden thread_local addrspace(8) global <4 x float>, !spirv.Decorations !3
+@shared = internal addrspace(10) global float 0.0
+
+define void @vs() #0 {
+entry:
+  %i = load i32, ptr addrspace(7) @vidx
+  %f = sitofp i32 %i to float
+  %v = insertelement <4 x float> zeroinitializer, float %f, i32 0
+  store <4 x float> %v, ptr addrspace(8) @out
+  ret void
+}
+
+; The fragment entry reaches @shared only through a helper.
+define internal spir_func float @helper() {
+entry:
+  %s = load float, ptr addrspace(10) @shared
+  ret float %s
+}
+
+define void @fs() #1 {
+entry:
+  %c = load <4 x float>, ptr addrspace(7) @in
+  %s = call spir_func float @helper()
+  %v = insertelement <4 x float> %c, float %s, i32 3
+  store <4 x float> %v, ptr addrspace(8) @color
+  ret void
+}
+
+attributes #0 = { "hlsl.shader"="vertex" }
+attributes #1 = { "hlsl.shader"="pixel" }
+
+!0 = !{i32 11, i32 42}
+!1 = !{!0}
+!2 = !{i32 30, i32 0}
+!3 = !{!2}
-- 
2.51.2

