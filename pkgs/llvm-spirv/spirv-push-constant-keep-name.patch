From bf9544c3e4e519d84e4912a423ba8156ee87124c Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Tue, 20 Oct 2026 03:00:29 +0300
Subject: [PATCH] [SPIRV] Keep a push-constant global's name

SPIRVPushConstantAccess replaces each push-constant global with one of
spirv.PushConstant type, created beside the original and so renamed
(`pc` became `pc.4`). A shader's interface is known by its names: the
replacement takes the original's.
---
 llvm/lib/Target/SPIRV/SPIRVPushConstantAccess.cpp | 3 +++
 llvm/test/CodeGen/SPIRV/vk-pushconstant-access.ll | 3 ++-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/llvm/lib/Target/SPIRV/SPIRVPushConstantAccess.cpp b/llvm/lib/Target/SPIRV/SPIRVPushConstantAccess.cpp
index 634c765741..96df82fec4 100644
--- a/llvm/lib/Target/SPIRV/SPIRVPushConstantAccess.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVPushConstantAccess.cpp
@@ -46,6 +46,9 @@ static bool replacePushConstantAccesses(Module &M, SPIRVGlobalRegistry *GR) {
                            /* InsertBefore= */ &GV, GV.getThreadLocalMode(),
                            GV.getAddressSpace(), GV.isExternallyInitialized());
     NewGV->setVisibility(GV.getVisibility());
+    // The global keeps its name, which a shader's interface is known by:
+    // made beside the original, the new one was renamed.
+    NewGV->takeName(&GV);
 
     for (User *U : make_early_inc_range(GV.users())) {
       Instruction *I = cast<Instruction>(U);
diff --git a/llvm/test/CodeGen/SPIRV/vk-pushconstant-access.ll b/llvm/test/CodeGen/SPIRV/vk-pushconstant-access.ll
index eb7c61018f..e1c9bdb445 100644
--- a/llvm/test/CodeGen/SPIRV/vk-pushconstant-access.ll
+++ b/llvm/test/CodeGen/SPIRV/vk-pushconstant-access.ll
@@ -4,6 +4,7 @@
 %struct.S = type <{ float }>
 
 ; CHECK-NOT: OpCapability Linkage
+; CHECK-DAG: OpName %[[#PCS:]] "pcs"
 
 ; CHECK-DAG: %[[#F32:]] = OpTypeFloat 32
 ; CHECK-DAG: %[[#UINT:]] = OpTypeInt 32 0
@@ -18,7 +19,7 @@
 
 
 @pcs = external hidden addrspace(13) externally_initialized global %struct.S, align 1
-; CHECK: %[[#PCS:]] = OpVariable %[[#PTR_PCS_S]] PushConstant
+; CHECK: %[[#PCS]] = OpVariable %[[#PTR_PCS_S]] PushConstant
 
 define void @main() #1 {
 entry:
