From 2793450d18790c4ca0fd4e44ea016211499afe51 Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Tue, 20 Oct 2026 19:45:29 +0300
Subject: [PATCH] [SPIRV] Accept Vulkan 1.0 and 1.1 triples

The logical SPIR-V target accepted only Vulkan 1.2 and 1.3
(`spirv1.5`/`spirv1.6`). Vulkan 1.1 is still the floor of many devices,
Android's baseline profile among them, and consumes SPIR-V up to 1.3.
Accept the logical architectures `spirv1.0` to `spirv1.4`, and map Vulkan
1.0 to SPIR-V 1.0 and Vulkan 1.1 to SPIR-V 1.3; a version a Vulkan release
does not consume (`spirv1.6-unknown-vulkan1.1`) stays invalid.
---
 llvm/lib/TargetParser/Triple.cpp              |  8 +++++++-
 llvm/test/CodeGen/SPIRV/vulkan1.1-spirv1.3.ll | 18 ++++++++++++++++++
 llvm/unittests/TargetParser/TripleTest.cpp    | 15 +++++++++++++++
 3 files changed, 40 insertions(+), 1 deletion(-)
 create mode 100644 llvm/test/CodeGen/SPIRV/vulkan1.1-spirv1.3.ll

diff --git a/llvm/lib/TargetParser/Triple.cpp b/llvm/lib/TargetParser/Triple.cpp
index fb54408c07..d8a4c26990 100644
--- a/llvm/lib/TargetParser/Triple.cpp
+++ b/llvm/lib/TargetParser/Triple.cpp
@@ -657,7 +657,9 @@ Triple::ArchType Triple::parseArch(StringRef ArchName) {
           .Case("hsail64", Triple::hsail64)
           .Case("spir", Triple::spir)
           .Case("spir64", Triple::spir64)
-          .Cases({"spirv", "spirv1.5", "spirv1.6"}, Triple::spirv)
+          .Cases({"spirv", "spirv1.0", "spirv1.1", "spirv1.2", "spirv1.3",
+                  "spirv1.4", "spirv1.5", "spirv1.6"},
+                 Triple::spirv)
           .Cases({"spirv32", "spirv32v1.0", "spirv32v1.1", "spirv32v1.2",
                   "spirv32v1.3", "spirv32v1.4", "spirv32v1.5", "spirv32v1.6"},
                  Triple::spirv32)
@@ -1645,6 +1647,10 @@ VersionTuple Triple::getVulkanVersion() const {
   SubArchType SpirvVersion = getSubArch();
 
   llvm::DenseMap<VersionTuple, SubArchType> ValidVersionMap = {
+      // Vulkan 1.0 -> SPIR-V 1.0.
+      {VersionTuple(1, 0), SPIRVSubArch_v10},
+      // Vulkan 1.1 -> SPIR-V 1.3.
+      {VersionTuple(1, 1), SPIRVSubArch_v13},
       // Vulkan 1.2 -> SPIR-V 1.5.
       {VersionTuple(1, 2), SPIRVSubArch_v15},
       // Vulkan 1.3 -> SPIR-V 1.6.
diff --git a/llvm/test/CodeGen/SPIRV/vulkan1.1-spirv1.3.ll b/llvm/test/CodeGen/SPIRV/vulkan1.1-spirv1.3.ll
new file mode 100644
index 0000000000..4409181195
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/vulkan1.1-spirv1.3.ll
@@ -0,0 +1,18 @@
+; Vulkan 1.1 consumes SPIR-V up to 1.3: a module for it is SPIR-V 1.3, and its
+; entry point lists only its Input and Output variables, as SPIR-V before 1.4
+; requires.
+
+; RUN: llc -O0 -mtriple=spirv1.3-unknown-vulkan1.1-compute %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.3-unknown-vulkan1.1-compute %s -o - -filetype=obj | spirv-dis | FileCheck %s --check-prefix=VERSION %}
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.3-unknown-vulkan1.1-compute %s -o - -filetype=obj | spirv-val --target-env vulkan1.1 %}
+
+; VERSION: ; Version: 1.3
+; CHECK-DAG: OpCapability Shader
+; CHECK-DAG: OpEntryPoint GLCompute %[[MAIN:[0-9]+]] "main"{{$}}
+
+define void @main() #0 {
+entry:
+  ret void
+}
+
+attributes #0 = { "hlsl.numthreads"="1,1,1" "hlsl.shader"="compute" }
diff --git a/llvm/unittests/TargetParser/TripleTest.cpp b/llvm/unittests/TargetParser/TripleTest.cpp
index a81801dc97..04ce31db3c 100644
--- a/llvm/unittests/TargetParser/TripleTest.cpp
+++ b/llvm/unittests/TargetParser/TripleTest.cpp
@@ -483,6 +483,21 @@ TEST(TripleTest, ParsedIDs) {
   EXPECT_EQ(VersionTuple(1, 3), T.getVulkanVersion());
   EXPECT_EQ(Triple::Compute, T.getEnvironment());
 
+  T = Triple("spirv1.3-unknown-vulkan1.1-compute");
+  EXPECT_EQ(Triple::spirv, T.getArch());
+  EXPECT_EQ(Triple::SPIRVSubArch_v13, T.getSubArch());
+  EXPECT_EQ(Triple::Vulkan, T.getOS());
+  EXPECT_EQ(VersionTuple(1, 1), T.getVulkanVersion());
+
+  T = Triple("spirv1.0-unknown-vulkan1.0-compute");
+  EXPECT_EQ(Triple::spirv, T.getArch());
+  EXPECT_EQ(Triple::SPIRVSubArch_v10, T.getSubArch());
+  EXPECT_EQ(VersionTuple(1, 0), T.getVulkanVersion());
+
+  // Vulkan 1.1 consumes SPIR-V up to 1.3, not 1.6.
+  T = Triple("spirv1.6-unknown-vulkan1.1-compute");
+  EXPECT_EQ(VersionTuple(0), T.getVulkanVersion());
+
   T = Triple("dxilv1.0--shadermodel6.0-pixel");
   EXPECT_EQ(Triple::dxil, T.getArch());
   EXPECT_EQ(Triple::DXILSubArch_v1_0, T.getSubArch());
-- 
