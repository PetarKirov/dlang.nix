From 1246fb0befcfe6408b05b9b16bf45ae5ba65ba70 Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Sat, 17 Oct 2026 11:47:10 +0300
Subject: [PATCH] [SPIRV] Do not materialise a resource's name string

The string a resource is named by (the last operand of
`spv.resource.handlefrombinding`) is read at instruction selection, for the
resource variable's OpName. Like every initialised global it was also given
an `spv.init.global`, which kept it alive as a Function-scope OpVariable
initialised with an array of bytes: every shader with a named resource
declared Int8, which Vulkan allows only where the device enables it. Skip
the initialisation for a global used only as a resource's name.

Two tests checked for the Int8 capability this leaked, and four matched the
byte array's ids; they now check that no Int8 is declared, or match what the
module holds.

Claude-Session: https://claude.ai/code/session_01TrgPqCXtysTg54Ef5n1nm6
---
 llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp | 17 ++++++++++-
 .../hlsl-resources/StorageImageConstIdx.ll    |  3 +-
 .../hlsl-resources/resource-name-no-int8.ll   | 26 ++++++++++++++++
 .../SPIRV/hlsl-resources/test_counters.ll     |  3 +-
 .../pointers/byte-address-buffer-store.ll     | 13 +++++---
 .../pointers/resource-vector-load-store.ll    |  1 -
 .../pointers/structured-buffer-access.ll      | 30 +++++++++----------
 .../structured-buffer-vector-access.ll        | 20 ++++++-------
 8 files changed, 76 insertions(+), 37 deletions(-)
 create mode 100644 llvm/test/CodeGen/SPIRV/hlsl-resources/resource-name-no-int8.ll

diff --git a/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp b/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp
index 2c62e7a8fe..35faeeb586 100644
--- a/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp
@@ -437,6 +437,21 @@ bool expectIgnoredInIRTranslation(const Instruction *I) {
                                  Intrinsic::spv_resource_getpointer>());
 }
 
+// A string a resource is named by is read at instruction selection, for the
+// resource variable's OpName; it is not a value of the program. Initialising
+// it would materialise it as an array of bytes, and a shader would need Int8.
+static bool isOnlyResourceName(const GlobalVariable &GV) {
+  if (GV.use_empty())
+    return false;
+  return all_of(GV.uses(), [](const Use &U) {
+    const auto *II = dyn_cast<IntrinsicInst>(U.getUser());
+    return II && U.getOperandNo() == 4 &&
+           (II->getIntrinsicID() == Intrinsic::spv_resource_handlefrombinding ||
+            II->getIntrinsicID() ==
+                Intrinsic::spv_resource_handlefromimplicitbinding);
+  });
+}
+
 // Returns the source pointer from `I` ignoring intermediate ptrcast.
 Value *getPointerRoot(Value *I) {
   Value *V;
@@ -3001,7 +3016,7 @@ void SPIRVEmitIntrinsicsImpl::processGlobalValue(GlobalVariable &GV,
   deduceElementTypeHelper(&GV, false);
 
   Constant *Init = nullptr;
-  if (hasInitializer(&GV)) {
+  if (hasInitializer(&GV) && !isOnlyResourceName(GV)) {
     Init = GV.getInitializer();
     Value *InitOp = Init;
     if (isa<UndefValue>(Init) && Init->getType()->isAggregateType()) {
