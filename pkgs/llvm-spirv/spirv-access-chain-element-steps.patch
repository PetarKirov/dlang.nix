From 2c703fe0c1c407397311f0570c87a963e73b9d2c Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Tue, 20 Oct 2026 00:59:35 +0300
Subject: [PATCH] [SPIRV] Fold whole element steps into the index of a logical
 access chain

An optimiser splits t[i + k] into an element's address and a constant byte
offset past it: gep i8 (gep [S x i8] t, i), C with C >= S. The logical
access chain built for the outer GEP starts inside the element and cannot
step to the next one, and the walk asserted
("Offset < VT->getNumElements() * EltTypeSize").

Fold the whole elements the offset steps over into the element's index,
gep [S x i8] t, (i + C / S), and index the rest, C % S, inside it. A buffer
device address may step, and keeps its GEPs.
---
 llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp | 46 +++++++++++++++-
 .../logical-access-chain-step-elements.ll     | 53 +++++++++++++++++++
 2 files changed, 98 insertions(+), 1 deletion(-)
 create mode 100644 llvm/test/CodeGen/SPIRV/logical-access-chain-step-elements.ll

diff --git a/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp b/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp
index 19523cb79c..82c3825849 100644
--- a/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp
@@ -272,6 +272,48 @@ static void lowerWholeObjectMemSets(Function &F) {
   }
 }
 
+// An optimiser splits t[i + k] into an element's address and a constant byte
+// offset past it, gep i8 (gep [S x i8] t, i), C with C >= S. A logical access
+// chain starts inside the element and cannot step to another, so the whole
+// elements the offset steps over join the element's index, gep [S x i8] t,
+// (i + C / S), and only the rest, C % S, indexes inside it. A buffer device
+// address may step, and keeps its GEPs.
+static void foldElementSteps(Function &F, bool UsesPhysicalStorageBuffer) {
+  SmallVector<GetElementPtrInst *> GEPs;
+  for (Instruction &I : instructions(F))
+    if (auto *G = dyn_cast<GetElementPtrInst>(&I))
+      GEPs.push_back(G);
+  for (GetElementPtrInst *G : GEPs) {
+    if (UsesPhysicalStorageBuffer && G->getPointerAddressSpace() == 1)
+      continue;
+    std::optional<uint64_t> Unit =
+        getByteAddressingMultiplier(G->getSourceElementType());
+    auto *Offset = dyn_cast<ConstantInt>(G->getOperand(1));
+    auto *Elem = dyn_cast<GetElementPtrInst>(G->getPointerOperand());
+    if (!Unit || G->getNumIndices() != 1 || !Offset || Offset->isNegative() ||
+        !Elem || Elem->getNumIndices() != 1 ||
+        isa<ConstantInt>(Elem->getOperand(1)))
+      continue;
+    std::optional<uint64_t> Stride =
+        getByteAddressingMultiplier(Elem->getSourceElementType());
+    const uint64_t Bytes = Offset->getZExtValue() * *Unit;
+    if (!Stride || Bytes < *Stride)
+      continue;
+    IRBuilder<> B(G);
+    Value *Index = narrowLogicalIndex(Elem->getOperand(1));
+    Value *Stepped =
+        B.CreateAdd(Index, ConstantInt::get(Index->getType(), Bytes / *Stride));
+    Value *New = B.CreateGEP(Elem->getSourceElementType(),
+                             Elem->getPointerOperand(), Stepped);
+    if (Bytes % *Stride)
+      New = B.CreateGEP(B.getInt8Ty(), New, B.getInt32(Bytes % *Stride));
+    G->replaceAllUsesWith(New);
+    G->eraseFromParent();
+    if (Elem->use_empty())
+      Elem->eraseFromParent();
+  }
+}
+
 // The padded element <{T, spirv.Padding}> of a peeled array type, or null.
 static Type *getPeeledArrayPaddedElement(Type *Ty) {
   auto *ST = dyn_cast<StructType>(Ty);
@@ -4064,8 +4106,10 @@ bool SPIRVEmitIntrinsicsImpl::runOnFunction(Function &Func) {
 
   processParamTypesByFunHeader(CurrF, B);
 
-  if (ST.isLogicalSPIRV())
+  if (ST.isLogicalSPIRV()) {
+    foldElementSteps(Func, ST.usesPhysicalStorageBuffer());
     lowerWholeObjectMemSets(Func);
+  }
 
   // Fix GEP result types ahead of inference, and simplify if possible.
   // Data structure for dead instructions that were simplified and replaced.
diff --git a/llvm/test/CodeGen/SPIRV/logical-access-chain-step-elements.ll b/llvm/test/CodeGen/SPIRV/logical-access-chain-step-elements.ll
new file mode 100644
index 0000000000..b12748e177
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/logical-access-chain-step-elements.ll
@@ -0,0 +1,53 @@
+; RUN: llc -O0 -verify-machineinstrs -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - -filetype=obj | spirv-val --target-env vulkan1.3 %}
+
+; An optimiser splits `t[i + 1]` into an element address and a constant byte
+; offset past it: gep i8 (gep [16 x i8] t, i), 16. A logical access chain
+; cannot step from one element to the next, so the whole elements the offset
+; steps over join the index, t[i + 1], and only what is left indexes inside
+; the element: t[i + 1].y for an offset of 20.
+
+; CHECK-NOT: OpTypeInt 64
+; CHECK-DAG: %[[UINT:[0-9]+]] = OpTypeInt 32 0
+; CHECK-DAG: %[[ONE:[0-9]+]] = OpConstant %[[UINT]] 1{{$}}
+; CHECK: %[[I:[0-9]+]] = OpBitwiseAnd %[[UINT]]
+; CHECK: %[[J:[0-9]+]] = OpIAdd %[[UINT]] %[[I]] %[[ONE]]
+; CHECK: Op{{(InBounds)?}}AccessChain %{{[0-9]+}} %{{[0-9]+}} %[[J]]{{$}}
+; CHECK: %[[K:[0-9]+]] = OpIAdd %[[UINT]] %[[I]] %[[ONE]]
+; CHECK: %[[EK:[0-9]+]] = Op{{(InBounds)?}}AccessChain %{{[0-9]+}} %{{[0-9]+}} %[[K]]{{$}}
+; CHECK: Op{{(InBounds)?}}AccessChain %{{[0-9]+}} %[[EK]] %[[ONE]]{{$}}
+
+@.str.o = private unnamed_addr constant [4 x i8] c"Out\00", align 1
+
+define void @main() #0 {
+entry:
+  %t = alloca [3 x <4 x float>], align 16
+  %t1 = getelementptr inbounds nuw i8, ptr %t, i64 16
+  %t2 = getelementptr inbounds nuw i8, ptr %t, i64 32
+  store <4 x float> <float 1.0, float 0.0, float 0.0, float 1.0>, ptr %t, align 16
+  store <4 x float> <float 0.0, float 1.0, float 0.0, float 1.0>, ptr %t1, align 16
+  store <4 x float> <float 0.0, float 0.0, float 1.0, float 1.0>, ptr %t2, align 16
+  %tid = tail call i32 @llvm.spv.thread.id.i32(i32 0)
+  %i = and i32 %tid, 1
+  %si = sext i32 %i to i64
+  %e = getelementptr [16 x i8], ptr %t, i64 %si
+
+; t[i + 1]
+  %n = getelementptr i8, ptr %e, i64 16
+  %v = load <4 x float>, ptr %n, align 16
+
+; t[i + 1].y
+  %y = getelementptr i8, ptr %e, i64 20
+  %w = load float, ptr %y, align 4
+
+  %x = extractelement <4 x float> %v, i32 0
+  %s = fadd float %x, %w
+  %o = tail call target("spirv.VulkanBuffer", [0 x float], 12, 1) @llvm.spv.resource.handlefrombinding.O(i32 0, i32 2, i32 1, i32 0, ptr nonnull @.str.o)
+  %po = tail call ptr addrspace(11) @llvm.spv.resource.getpointer.p11.O(target("spirv.VulkanBuffer", [0 x float], 12, 1) %o, i32 0)
+  store float %s, ptr addrspace(11) %po
+  ret void
+}
+
+declare i32 @llvm.spv.thread.id.i32(i32)
+
+attributes #0 = { "hlsl.numthreads"="1,1,1" "hlsl.shader"="compute" }
