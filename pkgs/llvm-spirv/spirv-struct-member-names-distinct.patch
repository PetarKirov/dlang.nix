From 6dd40da87be11646ef5556a67072684f742d297a Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Tue, 20 Oct 2026 03:23:12 +0300
Subject: [PATCH] [SPIRV] Keep structs with named members distinct

Global instructions are merged by signature, which for OpTypeStruct is its
member types and decorations. Two structs with the same members but
different names were therefore one type, carrying both OpNames and both
sets of OpMemberNames, so a reflected or translated module named one after
the other: a shader's push-constant block and its uniform block of one
float, say.

When a struct's members are named (spirv.MemberNames), its OpName and
OpMemberNames join its signature. Structs without member names still merge
as before, which hlsl-resources/Packed.ll relies on.
---
 llvm/lib/Target/SPIRV/SPIRVModuleAnalysis.cpp | 27 +++++++++++
 .../SPIRV/struct-member-names-distinct.ll     | 46 +++++++++++++++++++
 2 files changed, 73 insertions(+)
 create mode 100644 llvm/test/CodeGen/SPIRV/struct-member-names-distinct.ll

diff --git a/llvm/lib/Target/SPIRV/SPIRVModuleAnalysis.cpp b/llvm/lib/Target/SPIRV/SPIRVModuleAnalysis.cpp
index 617fd9bc36..25b3511574 100644
--- a/llvm/lib/Target/SPIRV/SPIRVModuleAnalysis.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVModuleAnalysis.cpp
@@ -295,6 +295,27 @@ static void appendDecorationsForReg(const MachineRegisterInfo &MRI, Register R,
   }
 }
 
+// Appends the signature of the OpName and OpMemberName instructions that name
+// R to Signature, if R's members are named: a frontend names the members of a
+// struct whose names reach the module's consumer, such as an interface block
+// read by reflection or translated to a shading language.
+static void appendNamesForReg(const MachineRegisterInfo &MRI, Register R,
+                              InstrSignature &Signature) {
+  if (none_of(MRI.use_instructions(R), [](const MachineInstr &UseMI) {
+        return UseMI.getOpcode() == SPIRV::OpMemberName;
+      }))
+    return;
+  for (MachineInstr &UseMI : MRI.use_instructions(R)) {
+    if (UseMI.getOpcode() != SPIRV::OpName &&
+        UseMI.getOpcode() != SPIRV::OpMemberName)
+      continue;
+    Signature.push_back(UseMI.getOpcode());
+    for (const MachineOperand &MO : UseMI.operands())
+      if (!MO.isReg())
+        Signature.push_back(hash_value(MO));
+  }
+}
+
 // Returns a representation of an instruction as a vector of MachineOperand
 // hash values, see llvm::hash_value(const MachineOperand &MO) for details.
 // This creates a signature of the instruction with the same content
@@ -355,6 +376,12 @@ static InstrSignature instrToSignature(const MachineInstr &MI,
     // identical instruction with different decorations cannot be merged. That
     // is why we add the decorations to the signature.
     appendDecorationsForReg(MI.getMF()->getRegInfo(), DefReg, Signature);
+    // Two structs with the same members and named members are two types
+    // when their names differ: merged, one id would carry both OpNames and
+    // both sets of OpMemberNames, and a reflected or translated module would
+    // name one struct after the other.
+    if (MI.getOpcode() == SPIRV::OpTypeStruct)
+      appendNamesForReg(MI.getMF()->getRegInfo(), DefReg, Signature);
   }
   return Signature;
 }
diff --git a/llvm/test/CodeGen/SPIRV/struct-member-names-distinct.ll b/llvm/test/CodeGen/SPIRV/struct-member-names-distinct.ll
new file mode 100644
index 0000000000..5ec6fc8119
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/struct-member-names-distinct.ll
@@ -0,0 +1,46 @@
+; RUN: llc -O0 -verify-machineinstrs -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - -filetype=obj | spirv-val --target-env vulkan1.3 %}
+
+; Two structs with the same members stay two types when their members are
+; named (spirv.MemberNames): each id carries its own OpName and
+; OpMemberNames. Structs without member names still merge.
+
+; CHECK-DAG: OpName %[[A:[0-9]+]] "A"
+; CHECK-DAG: OpMemberName %[[A]] 0 "a"
+; CHECK-DAG: OpName %[[B:[0-9]+]] "B"
+; CHECK-DAG: OpMemberName %[[B]] 0 "b"
+; CHECK-DAG: %[[FLOAT:[0-9]+]] = OpTypeFloat 32
+; CHECK-DAG: %[[A]] = OpTypeStruct %[[FLOAT]] %[[FLOAT]] %[[FLOAT]] %[[FLOAT]]{{$}}
+; CHECK-DAG: %[[B]] = OpTypeStruct %[[FLOAT]] %[[FLOAT]] %[[FLOAT]] %[[FLOAT]]{{$}}
+; CHECK-NOT: OpName %[[A]] "B"
+; CHECK-NOT: OpName %[[B]] "A"
+
+%A = type { float, float, float, float }
+%B = type { float, float, float, float }
+
+@.str.a = private unnamed_addr constant [2 x i8] c"x\00", align 1
+@.str.b = private unnamed_addr constant [2 x i8] c"y\00", align 1
+@.str.o = private unnamed_addr constant [4 x i8] c"Out\00", align 1
+
+define void @main() #0 {
+entry:
+  %ha = tail call target("spirv.VulkanBuffer", target("spirv.Layout", %A, 16, 0, 4, 8, 12), 2, 0) @llvm.spv.resource.handlefrombinding.A(i32 0, i32 1, i32 1, i32 0, ptr nonnull @.str.a)
+  %pa = tail call ptr addrspace(12) @llvm.spv.resource.getpointer.p12.A(target("spirv.VulkanBuffer", target("spirv.Layout", %A, 16, 0, 4, 8, 12), 2, 0) %ha, i32 0)
+  %a = load float, ptr addrspace(12) %pa
+  %hb = tail call target("spirv.VulkanBuffer", target("spirv.Layout", %B, 16, 0, 4, 8, 12), 2, 0) @llvm.spv.resource.handlefrombinding.B(i32 0, i32 2, i32 1, i32 0, ptr nonnull @.str.b)
+  %pb = tail call ptr addrspace(12) @llvm.spv.resource.getpointer.p12.B(target("spirv.VulkanBuffer", target("spirv.Layout", %B, 16, 0, 4, 8, 12), 2, 0) %hb, i32 0)
+  %b = load float, ptr addrspace(12) %pb
+  %s = fadd float %a, %b
+  %o = tail call target("spirv.VulkanBuffer", [0 x float], 12, 1) @llvm.spv.resource.handlefrombinding.O(i32 0, i32 3, i32 1, i32 0, ptr nonnull @.str.o)
+  %po = tail call ptr addrspace(11) @llvm.spv.resource.getpointer.p11.O(target("spirv.VulkanBuffer", [0 x float], 12, 1) %o, i32 0)
+  store float %s, ptr addrspace(11) %po
+  ret void
+}
+
+attributes #0 = { "hlsl.numthreads"="1,1,1" "hlsl.shader"="compute" }
+
+!llvm.module.flags = !{!0}
+!spirv.MemberNames = !{!1, !2}
+!0 = !{i32 1, !"spirv.struct-blocks", i32 1}
+!1 = !{%A poison, !"a"}
+!2 = !{%B poison, !"b"}
-- 
