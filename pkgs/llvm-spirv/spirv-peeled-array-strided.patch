-    addArrayStrideDecorations(ArrayType->defs().begin()->getReg(), ET,
-                              MIRBuilder);
+    if (Stride) {
+      buildOpDecorate(ArrayType->defs().begin()->getReg(), MIRBuilder,
+                      SPIRV::Decoration::ArrayStride, {*Stride});
