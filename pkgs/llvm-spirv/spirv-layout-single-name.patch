From 5b16c263499adb7e61c75b378b6d05cebf1a6fdc Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Tue, 20 Oct 2026 00:36:49 +0300
Subject: [PATCH] [SPIRV] Name a laid-out struct once

A spirv.Layout lowers to an OpTypeStruct already named after its struct; the
generic OpName for builtin types named it "spirv.Layout" a second time.
---
 llvm/lib/Target/SPIRV/SPIRVBuiltins.cpp                     | 6 ++++--
 llvm/test/CodeGen/SPIRV/hlsl-resources/spirv.layout.type.ll | 4 ++++
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/llvm/lib/Target/SPIRV/SPIRVBuiltins.cpp b/llvm/lib/Target/SPIRV/SPIRVBuiltins.cpp
index 20cf9275af..8b3dd12dee 100644
--- a/llvm/lib/Target/SPIRV/SPIRVBuiltins.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVBuiltins.cpp
@@ -4178,8 +4178,10 @@ lowerBuiltinType(const Type *OpaqueType,
   }
 
   // Emit OpName instruction if a new OpType<...> instruction was added
-  // (equivalent type was not found in GlobalRegistry).
-  if (NumStartingVRegs < MIRBuilder.getMRI()->getNumVirtRegs())
+  // (equivalent type was not found in GlobalRegistry). A spirv.Layout is its
+  // struct, already named after it.
+  if (NumStartingVRegs < MIRBuilder.getMRI()->getNumVirtRegs() &&
+      Name != "spirv.Layout")
     buildOpName(GR->getSPIRVTypeID(TargetType), Name, MIRBuilder);
 
   return TargetType;
diff --git a/llvm/test/CodeGen/SPIRV/hlsl-resources/spirv.layout.type.ll b/llvm/test/CodeGen/SPIRV/hlsl-resources/spirv.layout.type.ll
index ac53873701..c281bd4877 100644
--- a/llvm/test/CodeGen/SPIRV/hlsl-resources/spirv.layout.type.ll
+++ b/llvm/test/CodeGen/SPIRV/hlsl-resources/spirv.layout.type.ll
@@ -1,6 +1,10 @@
 ; RUN: llc -O0 -verify-machineinstrs -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - | FileCheck %s
+; RUN: llc -O0 -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - | FileCheck %s --check-prefix=NAME
 ; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - -filetype=obj | spirv-val %}
 
+; A laid-out struct keeps the name of its struct, and only that one.
+; NAME-NOT: OpName {{.*}} "spirv.Layout"
+
 target datalayout = "e-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-n8:16:32:64-G10"
 
 @.str.b0 = private unnamed_addr constant [3 x i8] c"B0\00", align 1
-- 
2.51.2

