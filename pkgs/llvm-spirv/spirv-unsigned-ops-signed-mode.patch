From 7fbe4102ed040697da81d6f1190955824779de7d Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Tue, 20 Oct 2026 00:57:26 +0300
Subject: [PATCH] [SPIRV] Compute unsigned division and conversion in an
 unsigned type

With spirv.signed-integers the module's integer types are signed, but
OpUDiv, OpUMod and OpConvertFToU require an unsigned result type, so any
unsigned division, remainder or float-to-unsigned conversion produced a
module spirv-val rejects ("Expected unsigned int scalar or vector type as
Result Type").

They now compute in the unsigned twin of their type, an OpTypeInt with
signedness 0 (or a vector of it) keyed by width and length, between
bitcasts, which is what the operations mean on the signed values.
---
 llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp | 33 ++++++++++++
 llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.h   |  5 ++
 llvm/lib/Target/SPIRV/SPIRVIRMapping.h        |  6 +++
 llvm/lib/Target/SPIRV/SPIRVISelLowering.cpp   | 46 ++++++++++++++++
 .../SPIRV/signed-integers-unsigned-ops.ll     | 54 +++++++++++++++++++
 5 files changed, 144 insertions(+)
 create mode 100644 llvm/test/CodeGen/SPIRV/signed-integers-unsigned-ops.ll

diff --git a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
index 7acf2a0eb8..ff7f266df5 100644
--- a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
@@ -1691,6 +1691,39 @@ SPIRVGlobalRegistry::getOrCreatePaddingType(MachineIRBuilder &MIRBuilder) {
   return R;
 }
 
+// In a module whose integers are signed (spirv.signed-integers), an LLVM
+// integer type has only its signed SPIR-V type. The unsigned twin has no LLVM
+// type of its own, so it is keyed by width and vector length.
+SPIRVTypeInst
+SPIRVGlobalRegistry::getOrCreateUnsignedTwin(SPIRVTypeInst Ty,
+                                             MachineIRBuilder &MIRBuilder) {
+  unsigned NumElems = 0;
+  SPIRVTypeInst Scalar = Ty;
+  if (Ty->getOpcode() == SPIRV::OpTypeVector) {
+    NumElems = Ty->getOperand(2).getImm();
+    Scalar = getSPIRVTypeForVReg(Ty->getOperand(1).getReg());
+  }
+  if (!Scalar || Scalar->getOpcode() != SPIRV::OpTypeInt ||
+      Scalar->getOperand(2).getImm() == 0)
+    return Ty;
+  const unsigned Width = Scalar->getOperand(1).getImm();
+  auto Key = SPIRV::irhandle_unsigned_int(Width, NumElems);
+  if (const MachineInstr *MI = findMI(Key, &MIRBuilder.getMF()))
+    return MI;
+  // Registered by its register only, with the LLVM type it stands for, so
+  // that sizes and component types resolve; LLVM types still map to the
+  // signed type.
+  LLVMContext &Ctx = MIRBuilder.getMF().getFunction().getContext();
+  Type *LLVMTy = IntegerType::get(Ctx, Width);
+  SPIRVTypeInst R = finishCreatingSPIRVType(
+      LLVMTy, getOpTypeInt(Width, MIRBuilder, /*IsSigned=*/false));
+  if (NumElems)
+    R = finishCreatingSPIRVType(FixedVectorType::get(LLVMTy, NumElems),
+                                getOpTypeVector(NumElems, R, MIRBuilder));
+  add(Key, R);
+  return R;
+}
+
 SPIRVTypeInst SPIRVGlobalRegistry::getOrCreateVulkanPushConstantType(
     MachineIRBuilder &MIRBuilder, Type *T) {
   const auto SC = SPIRV::StorageClass::PushConstant;
diff --git a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.h b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.h
index e27d778438..8a11caffe3 100644
--- a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.h
+++ b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.h
@@ -696,6 +696,11 @@ public:
 
   SPIRVTypeInst getOrCreatePaddingType(MachineIRBuilder &MIRBuilder);
 
+  // The unsigned twin of a signed integer or integer vector type, or the type
+  // itself if it is not signed.
+  SPIRVTypeInst getOrCreateUnsignedTwin(SPIRVTypeInst Ty,
+                                        MachineIRBuilder &MIRBuilder);
+
   SPIRVTypeInst getOrCreateVulkanPushConstantType(MachineIRBuilder &MIRBuilder,
                                                   Type *ElemType);
 
diff --git a/llvm/lib/Target/SPIRV/SPIRVIRMapping.h b/llvm/lib/Target/SPIRV/SPIRVIRMapping.h
index c845a87a80..6b2d3625f1 100644
--- a/llvm/lib/Target/SPIRV/SPIRVIRMapping.h
+++ b/llvm/lib/Target/SPIRV/SPIRVIRMapping.h
@@ -67,6 +67,7 @@ enum SpecialTypeKind {
   STK_Padding,
   STK_ExplictLayoutType,
   STK_UntypedPointer,
+  STK_UnsignedInt,
   STK_Last = -1
 };
 
@@ -155,6 +156,11 @@ inline IRHandle irhandle_padding() {
   return std::make_tuple(nullptr, 0, SpecialTypeKind::STK_Padding);
 }
 
+inline IRHandle irhandle_unsigned_int(unsigned Width, unsigned NumElems) {
+  return std::make_tuple(nullptr, (Width << 16) | NumElems,
+                         SpecialTypeKind::STK_UnsignedInt);
+}
+
 inline IRHandle irhandle_untyped_pointer(unsigned AddressSpace) {
   return std::make_tuple(nullptr, AddressSpace,
                          SpecialTypeKind::STK_UntypedPointer);
diff --git a/llvm/lib/Target/SPIRV/SPIRVISelLowering.cpp b/llvm/lib/Target/SPIRV/SPIRVISelLowering.cpp
index 060f752faa..3fab3c4633 100644
--- a/llvm/lib/Target/SPIRV/SPIRVISelLowering.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVISelLowering.cpp
@@ -432,6 +432,43 @@ void validateAccessChain(const SPIRVSubtarget &STI, MachineRegisterInfo *MRI,
   }
 }
 
+// In a module whose integers are signed (spirv.signed-integers), OpUDiv,
+// OpUMod and OpConvertFToU still need an unsigned result type: they compute in
+// the type's unsigned twin, between bitcasts.
+static void computeInUnsignedTwin(const SPIRVSubtarget &STI,
+                                  MachineRegisterInfo *MRI,
+                                  SPIRVGlobalRegistry &GR, MachineInstr &MI,
+                                  bool CastOperands) {
+  Register TypeReg = MI.getOperand(1).getReg();
+  SPIRVTypeInst ResTy = GR.getSPIRVTypeForVReg(TypeReg);
+  MachineIRBuilder MIB(MI);
+  SPIRVTypeInst UTy = GR.getOrCreateUnsignedTwin(ResTy, MIB);
+  if (UTy == ResTy)
+    return;
+  MachineFunction &MF = *MI.getMF();
+  auto Cast = [&](MachineIRBuilder &B, Register Dst, Register TyReg,
+                  Register Src) {
+    B.buildInstr(SPIRV::OpBitcast)
+        .addDef(Dst)
+        .addUse(TyReg)
+        .addUse(Src)
+        .constrainAllUses(*STI.getInstrInfo(), *STI.getRegisterInfo(),
+                          *STI.getRegBankInfo());
+  };
+  if (CastOperands)
+    for (unsigned I = 2, E = MI.getNumOperands(); I != E; ++I) {
+      Register U = createVirtualRegister(UTy, &GR, MRI, MF);
+      Cast(MIB, U, GR.getSPIRVTypeID(UTy), MI.getOperand(I).getReg());
+      MI.getOperand(I).setReg(U);
+    }
+  Register Result = MI.getOperand(0).getReg();
+  Register UResult = createVirtualRegister(UTy, &GR, MRI, MF);
+  MI.getOperand(0).setReg(UResult);
+  MI.getOperand(1).setReg(GR.getSPIRVTypeID(UTy));
+  MachineIRBuilder After(*MI.getParent(), std::next(MI.getIterator()));
+  Cast(After, Result, TypeReg, UResult);
+}
+
 static void validateVec1Ops(const SPIRVSubtarget &STI, MachineRegisterInfo *MRI,
                             SPIRVGlobalRegistry &GR, MachineInstr &MI) {
   // IRTranslator does not believe that rank-1 vectors exist, unlike upstream
@@ -607,6 +644,15 @@ void SPIRVTargetLowering::finalizeLowering(MachineFunction &MF) const {
                                       SPIRV::OpTypeBool))
           MI.setDesc(STI.getInstrInfo()->get(SPIRV::OpLogicalNotEqual));
         break;
+      case SPIRV::OpUDivS:
+      case SPIRV::OpUDivV:
+      case SPIRV::OpUModS:
+      case SPIRV::OpUModV:
+        computeInUnsignedTwin(STI, MRI, GR, MI, /*CastOperands=*/true);
+        break;
+      case SPIRV::OpConvertFToU:
+        computeInUnsignedTwin(STI, MRI, GR, MI, /*CastOperands=*/false);
+        break;
       // multiplication of bool operands is equivalent to a logical AND
       case SPIRV::OpIMulS:
       case SPIRV::OpIMulV:
diff --git a/llvm/test/CodeGen/SPIRV/signed-integers-unsigned-ops.ll b/llvm/test/CodeGen/SPIRV/signed-integers-unsigned-ops.ll
new file mode 100644
index 0000000000..5dfff1668e
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/signed-integers-unsigned-ops.ll
@@ -0,0 +1,54 @@
+; RUN: llc -O0 -verify-machineinstrs -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - -filetype=obj | spirv-val --target-env vulkan1.3 %}
+
+; With spirv.signed-integers the module's integers are signed, but OpUDiv,
+; OpUMod and OpConvertFToU are defined only for an unsigned result type. They
+; compute in the unsigned twin of the type, between bitcasts, so a D `uint`
+; division is valid and means what it does on the host.
+
+; CHECK-DAG: %[[INT:[0-9]+]] = OpTypeInt 32 1
+; CHECK-DAG: %[[UINT:[0-9]+]] = OpTypeInt 32 0
+; CHECK-DAG: %[[INT2:[0-9]+]] = OpTypeVector %[[INT]] 2
+; CHECK-DAG: %[[UINT2:[0-9]+]] = OpTypeVector %[[UINT]] 2
+
+; CHECK: %[[A:[0-9]+]] = OpBitcast %[[UINT]] %{{[0-9]+}}
+; CHECK: %[[B:[0-9]+]] = OpBitcast %[[UINT]] %{{[0-9]+}}
+; CHECK: %[[Q:[0-9]+]] = OpUDiv %[[UINT]] %[[A]] %[[B]]
+; CHECK: OpBitcast %[[INT]] %[[Q]]
+; CHECK: %[[R:[0-9]+]] = OpUMod %[[UINT]]
+; CHECK: OpBitcast %[[INT]] %[[R]]
+; CHECK: %[[F:[0-9]+]] = OpConvertFToU %[[UINT]]
+; CHECK: OpBitcast %[[INT]] %[[F]]
+; CHECK: %[[QV:[0-9]+]] = OpUDiv %[[UINT2]]
+; CHECK: OpBitcast %[[INT2]] %[[QV]]
+; CHECK-NOT: OpUDiv %[[INT]]
+; CHECK-NOT: OpUMod %[[INT]]
+
+@.str.o = private unnamed_addr constant [4 x i8] c"Out\00", align 1
+
+define void @main() #0 {
+entry:
+  %a = tail call i32 @llvm.spv.thread.id.i32(i32 0)
+  %b = tail call i32 @llvm.spv.thread.id.i32(i32 1)
+  %q = udiv i32 %a, %b
+  %r = urem i32 %q, %b
+  %f = sitofp i32 %r to float
+  %u = fptoui float %f to i32
+  %va0 = insertelement <2 x i32> poison, i32 %a, i32 0
+  %va = insertelement <2 x i32> %va0, i32 %u, i32 1
+  %vb0 = insertelement <2 x i32> poison, i32 %b, i32 0
+  %vb = insertelement <2 x i32> %vb0, i32 %b, i32 1
+  %vq = udiv <2 x i32> %va, %vb
+  %e = extractelement <2 x i32> %vq, i32 1
+  %o = tail call target("spirv.VulkanBuffer", [0 x i32], 12, 1) @llvm.spv.resource.handlefrombinding.O(i32 0, i32 2, i32 1, i32 0, ptr nonnull @.str.o)
+  %po = tail call ptr addrspace(11) @llvm.spv.resource.getpointer.p11.O(target("spirv.VulkanBuffer", [0 x i32], 12, 1) %o, i32 0)
+  store i32 %e, ptr addrspace(11) %po
+  ret void
+}
+
+declare i32 @llvm.spv.thread.id.i32(i32)
+
+attributes #0 = { "hlsl.numthreads"="1,1,1" "hlsl.shader"="compute" }
+
+!llvm.module.flags = !{!0}
+!0 = !{i32 1, !"spirv.signed-integers", i32 1}
