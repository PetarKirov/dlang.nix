From c6c76bce973e39bcabb414d1790cbe084879ffaa Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Thu, 15 Oct 2026 13:36:41 +0300
Subject: [PATCH] [SPIRV] Signed integers on request; struct member names for
 shader interfaces

LLVM integers are signless, so the backend emits every one as `OpTypeInt N 0`.
A shader's `int` uniform then reaches GLSL as `uint`, which the host binds
with the wrong call, and a GLSL ES 1.00 translation (which has no unsigned
types) meets unsigned types throughout. A frontend whose language's plain
integers are signed now asks for them signed with the module flag
`spirv.signed-integers`; unsigned operations keep their opcodes, which SPIR-V
allows on signed operands.

LLVM struct members have no names, so a plain uniform `struct` reaches GLSL
with members `_m0`, `_m1`. A module's `spirv.MemberNames` metadata, one node
per struct (`!{<struct> poison, !"name0", ...}`), emits an `OpMemberName` per
name.
---
 llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp | 50 ++++++++++++++++++-
 llvm/test/CodeGen/SPIRV/member-names.ll       | 23 +++++++++
 llvm/test/CodeGen/SPIRV/signed-integers.ll    | 27 ++++++++++
 3 files changed, 98 insertions(+), 2 deletions(-)
 create mode 100644 llvm/test/CodeGen/SPIRV/member-names.ll
 create mode 100644 llvm/test/CodeGen/SPIRV/signed-integers.ll

diff --git a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
index fea1e4474e..2d0fc040b8 100644
--- a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
@@ -26,6 +26,7 @@
 #include "llvm/IR/IntrinsicInst.h"
 #include "llvm/IR/Intrinsics.h"
 #include "llvm/IR/IntrinsicsSPIRV.h"
+#include "llvm/IR/Module.h"
 #include "llvm/IR/Type.h"
 #include "llvm/Support/Casting.h"
 #include "llvm/Support/MathExtras.h"
@@ -159,6 +160,18 @@ unsigned SPIRVGlobalRegistry::adjustOpTypeIntWidth(unsigned Width) const {
   reportFatalUsageError("Unsupported Integer width!");
 }
 
+// LLVM's integers carry no sign, and the backend emits them unsigned. A
+// frontend whose language's plain integers are signed asks for them signed
+// with the module flag `spirv.signed-integers`: a shader translated to GLSL
+// then declares its `int`s as `int`, which is how the host binds a uniform,
+// and a target with no unsigned types (GLSL ES 1.00) sees none.
+static bool emitsSignedIntegers(const MachineFunction &MF) {
+  const Module *M = MF.getFunction().getParent();
+  const auto *Flag = mdconst::extract_or_null<ConstantInt>(
+      M->getModuleFlag("spirv.signed-integers"));
+  return Flag && !Flag->isZero();
+}
+
 SPIRVTypeInst SPIRVGlobalRegistry::getOpTypeInt(unsigned Width,
                                                 MachineIRBuilder &MIRBuilder,
                                                 bool IsSigned) {
@@ -1046,6 +1059,36 @@ SPIRVGlobalRegistry::getOpTypeOpaque(const StructType *Ty,
       });
 }
 
+// LLVM struct members have no names, but a shader's interface is linked by
+// them: a plain uniform `struct { float gain; }` is set as `light.gain`. A
+// frontend names them in the module's `spirv.MemberNames` metadata, one node
+// per struct, `!{<struct> poison, !"name0", !"name1", ...}`, and each becomes
+// an `OpMemberName`.
+static void buildOpMemberNames(const StructType *Ty, Register ResVReg,
+                               MachineIRBuilder &MIRBuilder) {
+  const Module *M = MIRBuilder.getMF().getFunction().getParent();
+  const NamedMDNode *Names = M->getNamedMetadata("spirv.MemberNames");
+  if (!Names)
+    return;
+  for (const MDNode *Node : Names->operands()) {
+    const auto *Key = Node->getNumOperands() == 0
+                          ? nullptr
+                          : dyn_cast<ConstantAsMetadata>(Node->getOperand(0));
+    if (!Key || Key->getValue()->getType() != Ty)
+      continue;
+    for (unsigned I = 1, E = Node->getNumOperands(); I < E; ++I) {
+      const auto *Name = dyn_cast<MDString>(Node->getOperand(I));
+      if (!Name || Name->getString().empty())
+        continue;
+      auto MIB = MIRBuilder.buildInstr(SPIRV::OpMemberName)
+                     .addUse(ResVReg)
+                     .addImm(I - 1);
+      addStringImm(Name->getString(), MIB);
+    }
+    return;
+  }
+}
+
 SPIRVTypeInst SPIRVGlobalRegistry::getOpTypeStruct(
     const StructType *Ty, MachineIRBuilder &MIRBuilder,
     SPIRV::AccessQualifier::AccessQualifier AccQual,
@@ -1086,6 +1129,7 @@ SPIRVTypeInst SPIRVGlobalRegistry::getOpTypeStruct(
   Register ResVReg = createTypeVReg(MIRBuilder);
   if (Ty->hasName())
     buildOpName(ResVReg, Ty->getName(), MIRBuilder);
+  buildOpMemberNames(Ty, ResVReg, MIRBuilder);
   if (Ty->isPacked() && !ST.isShader())
     buildOpDecorate(ResVReg, MIRBuilder, SPIRV::Decoration::CPacked, {});
 
@@ -1239,7 +1283,8 @@ SPIRVTypeInst SPIRVGlobalRegistry::createSPIRVType(
   if (auto IType = dyn_cast<IntegerType>(Ty)) {
     const unsigned Width = IType->getBitWidth();
     return Width == 1 ? getOpTypeBool(MIRBuilder)
-                      : getOpTypeInt(Width, MIRBuilder, false);
+                      : getOpTypeInt(Width, MIRBuilder,
+                                     emitsSignedIntegers(MIRBuilder.getMF()));
   }
   if (Ty->isFloatingPointTy()) {
     if (Ty->isFP128Ty() || Ty->isPPC_FP128Ty())
@@ -1950,7 +1995,8 @@ SPIRVGlobalRegistry::getOrCreateSPIRVType(unsigned BitWidth, MachineInstr &I,
                              .addImm(BitWidth);
         // Don't add Encoding to FP type
         if (!Ty->isFloatTy()) {
-          return NewTypeMI.addImm(0);
+          return NewTypeMI.addImm(SPIRVOPcode == SPIRV::OpTypeInt &&
+                                  emitsSignedIntegers(*I.getMF()));
         } else {
           return NewTypeMI;
         }
diff --git a/llvm/test/CodeGen/SPIRV/member-names.ll b/llvm/test/CodeGen/SPIRV/member-names.ll
new file mode 100644
index 0000000000..19864f7813
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/member-names.ll
@@ -0,0 +1,23 @@
+; The module's `spirv.MemberNames` metadata names a struct's members.
+
+; RUN: llc -verify-machineinstrs -O0 -mtriple=spirv-unknown-vulkan %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv-unknown-vulkan %s -o - -filetype=obj | spirv-val %}
+
+; CHECK-DAG: OpName [[light:%[0-9]+]] "Light"
+; CHECK-DAG: OpMemberName [[light]] 0 "gain"
+; CHECK-DAG: OpMemberName [[light]] 1 "colour"
+; CHECK-DAG: [[light]] = OpTypeStruct
+; CHECK-NOT: OpMemberName [[light]] 2
+%Light = type { float, <3 x float> }
+
+@light = external hidden addrspace(2) global %Light
+
+define float @gain() {
+entry:
+  %v = load %Light, ptr addrspace(2) @light
+  %g = extractvalue %Light %v, 0
+  ret float %g
+}
+
+!spirv.MemberNames = !{!0}
+!0 = !{%Light poison, !"gain", !"colour"}
diff --git a/llvm/test/CodeGen/SPIRV/signed-integers.ll b/llvm/test/CodeGen/SPIRV/signed-integers.ll
new file mode 100644
index 0000000000..1cbc9e9ea5
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/signed-integers.ll
@@ -0,0 +1,27 @@
+; With the module flag `spirv.signed-integers`, LLVM's signless integers are
+; emitted signed, and no unsigned integer type is left in the module.
+
+; RUN: llc -verify-machineinstrs -O0 -mtriple=spirv-unknown-vulkan %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv-unknown-vulkan %s -o - -filetype=obj | spirv-val %}
+
+; CHECK-DAG: [[int:%[0-9]+]] = OpTypeInt 32 1
+; CHECK-DAG: [[v2int:%[0-9]+]] = OpTypeVector [[int]] 2
+; CHECK-NOT: OpTypeInt 32 0
+; CHECK: OpLoad [[int]]
+; CHECK: OpIAdd [[int]]
+
+@n = external hidden addrspace(2) global i32
+@p = external hidden addrspace(2) global <2 x i32>
+
+define i32 @read(i32 %a) {
+entry:
+  %n = load i32, ptr addrspace(2) @n
+  %p = load <2 x i32>, ptr addrspace(2) @p
+  %y = extractelement <2 x i32> %p, i32 1
+  %s = add i32 %n, %a
+  %r = sdiv i32 %s, %y
+  ret i32 %r
+}
+
+!llvm.module.flags = !{!0}
+!0 = !{i32 1, !"spirv.signed-integers", i32 1}
-- 
