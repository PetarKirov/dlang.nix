From 303f67119871108d70057acf2f38ebca61bc0490 Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Thu, 15 Oct 2026 13:36:41 +0300
Subject: [PATCH] [SPIRV] Signed integers on request; struct member names for
 shader interfaces

LLVM integers are signless, so the backend emits every one as `OpTypeInt N 0`.
A shader's `int` uniform then reaches GLSL as `uint`, which the host binds
with the wrong call, and a GLSL ES 1.00 translation (which has no unsigned
types) meets unsigned types throughout. A frontend whose language's plain
integers are signed now asks for them signed with the module flag
`spirv.signed-integers`; unsigned operations keep their opcodes, which SPIR-V
allows on signed operands. Integers narrower than 32 bits stay unsigned, as
their literals are written zero-extended, which a signed type forbids.

LLVM struct members have no names, so a plain uniform `struct` reaches GLSL
with members `_m0`, `_m1`. A module's `spirv.MemberNames` metadata, one node
per struct (`!{<struct> poison, !"name0", ...}`), emits an `OpMemberName` per
name.
---
 llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp | 55 +++++++++++++++++-
 .../Target/SPIRV/SPIRVInstructionSelector.cpp | 19 +++++++
 llvm/test/CodeGen/SPIRV/member-names.ll       | 23 ++++++++
 .../CodeGen/SPIRV/signed-integers-zext.ll     | 57 +++++++++++++++++++
 llvm/test/CodeGen/SPIRV/signed-integers.ll    | 35 ++++++++++++
 5 files changed, 187 insertions(+), 2 deletions(-)
 create mode 100644 llvm/test/CodeGen/SPIRV/member-names.ll
 create mode 100644 llvm/test/CodeGen/SPIRV/signed-integers-zext.ll
 create mode 100644 llvm/test/CodeGen/SPIRV/signed-integers.ll

diff --git a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
index fea1e4474e..b53b672bea 100644
--- a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
@@ -26,6 +26,7 @@
 #include "llvm/IR/IntrinsicInst.h"
 #include "llvm/IR/Intrinsics.h"
 #include "llvm/IR/IntrinsicsSPIRV.h"
+#include "llvm/IR/Module.h"
 #include "llvm/IR/Type.h"
 #include "llvm/Support/Casting.h"
 #include "llvm/Support/MathExtras.h"
@@ -159,6 +160,23 @@ unsigned SPIRVGlobalRegistry::adjustOpTypeIntWidth(unsigned Width) const {
   reportFatalUsageError("Unsupported Integer width!");
 }
 
+// LLVM's integers carry no sign, and the backend emits them unsigned. A
+// frontend whose language's plain integers are signed asks for them signed
+// with the module flag `spirv.signed-integers`: a shader translated to GLSL
+// then declares its `int`s as `int`, which is how the host binds a uniform,
+// and a target with no unsigned types (GLSL ES 1.00) sees none. Integers
+// narrower than 32 bits stay unsigned: their literals are written
+// zero-extended, which SPIR-V allows only for an unsigned type (a signed one
+// needs them sign-extended), and no shading language the flag serves has them.
+static bool emitsSignedIntegers(const MachineFunction &MF, unsigned Width) {
+  if (Width < 32)
+    return false;
+  const Module *M = MF.getFunction().getParent();
+  const auto *Flag = mdconst::extract_or_null<ConstantInt>(
+      M->getModuleFlag("spirv.signed-integers"));
+  return Flag && !Flag->isZero();
+}
+
 SPIRVTypeInst SPIRVGlobalRegistry::getOpTypeInt(unsigned Width,
                                                 MachineIRBuilder &MIRBuilder,
                                                 bool IsSigned) {
@@ -1046,6 +1064,36 @@ SPIRVGlobalRegistry::getOpTypeOpaque(const StructType *Ty,
       });
 }
 
+// LLVM struct members have no names, but a shader's interface is linked by
+// them: a plain uniform `struct { float gain; }` is set as `light.gain`. A
+// frontend names them in the module's `spirv.MemberNames` metadata, one node
+// per struct, `!{<struct> poison, !"name0", !"name1", ...}`, and each becomes
+// an `OpMemberName`.
+static void buildOpMemberNames(const StructType *Ty, Register ResVReg,
+                               MachineIRBuilder &MIRBuilder) {
+  const Module *M = MIRBuilder.getMF().getFunction().getParent();
+  const NamedMDNode *Names = M->getNamedMetadata("spirv.MemberNames");
+  if (!Names)
+    return;
+  for (const MDNode *Node : Names->operands()) {
+    const auto *Key = Node->getNumOperands() == 0
+                          ? nullptr
+                          : dyn_cast<ConstantAsMetadata>(Node->getOperand(0));
+    if (!Key || Key->getValue()->getType() != Ty)
+      continue;
+    for (unsigned I = 1, E = Node->getNumOperands(); I < E; ++I) {
+      const auto *Name = dyn_cast<MDString>(Node->getOperand(I));
+      if (!Name || Name->getString().empty())
+        continue;
+      auto MIB = MIRBuilder.buildInstr(SPIRV::OpMemberName)
+                     .addUse(ResVReg)
+                     .addImm(I - 1);
+      addStringImm(Name->getString(), MIB);
+    }
+    return;
+  }
+}
+
 SPIRVTypeInst SPIRVGlobalRegistry::getOpTypeStruct(
     const StructType *Ty, MachineIRBuilder &MIRBuilder,
     SPIRV::AccessQualifier::AccessQualifier AccQual,
@@ -1086,6 +1134,7 @@ SPIRVTypeInst SPIRVGlobalRegistry::getOpTypeStruct(
   Register ResVReg = createTypeVReg(MIRBuilder);
   if (Ty->hasName())
     buildOpName(ResVReg, Ty->getName(), MIRBuilder);
+  buildOpMemberNames(Ty, ResVReg, MIRBuilder);
   if (Ty->isPacked() && !ST.isShader())
     buildOpDecorate(ResVReg, MIRBuilder, SPIRV::Decoration::CPacked, {});
 
@@ -1239,7 +1288,8 @@ SPIRVTypeInst SPIRVGlobalRegistry::createSPIRVType(
   if (auto IType = dyn_cast<IntegerType>(Ty)) {
     const unsigned Width = IType->getBitWidth();
     return Width == 1 ? getOpTypeBool(MIRBuilder)
-                      : getOpTypeInt(Width, MIRBuilder, false);
+                      : getOpTypeInt(Width, MIRBuilder,
+                                     emitsSignedIntegers(MIRBuilder.getMF(), Width));
   }
   if (Ty->isFloatingPointTy()) {
     if (Ty->isFP128Ty() || Ty->isPPC_FP128Ty())
@@ -1950,7 +2000,8 @@ SPIRVGlobalRegistry::getOrCreateSPIRVType(unsigned BitWidth, MachineInstr &I,
                              .addImm(BitWidth);
         // Don't add Encoding to FP type
         if (!Ty->isFloatTy()) {
-          return NewTypeMI.addImm(0);
+          return NewTypeMI.addImm(SPIRVOPcode == SPIRV::OpTypeInt &&
+                                  emitsSignedIntegers(*I.getMF(), BitWidth));
         } else {
           return NewTypeMI;
         }
diff --git a/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp b/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
index f1878ddced..880c5b925f 100644
--- a/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
@@ -4812,6 +4812,25 @@ bool SPIRVInstructionSelector::selectExt(Register ResVReg,
   if (ResType == SrcType)
     return BuildCOPY(ResVReg, SrcReg, I);
 
+  // OpUConvert's result must be unsigned, but a module that asks for signed
+  // integers (`spirv.signed-integers`) has no unsigned type of the result's
+  // width. Sign-extend instead, and clear the bits above the source's width.
+  if (!IsSigned && GR.isScalarOrVectorSigned(ResType)) {
+    Register Extended = MRI->createVirtualRegister(GR.getRegClass(ResType));
+    if (!selectOpWithSrcs(Extended, ResType, I, {SrcReg}, SPIRV::OpSConvert))
+      return false;
+    const APInt Mask =
+        APInt::getLowBitsSet(GR.getScalarOrVectorBitWidth(ResType),
+                             GR.getScalarOrVectorBitWidth(SrcType));
+    const bool IsVector = GR.getScalarOrVectorComponentCount(ResType) > 1;
+    Register MaskReg = IsVector
+                           ? GR.getOrCreateConstVector(Mask, I, ResType, TII)
+                           : GR.getOrCreateConstInt(Mask, I, ResType, TII);
+    return selectOpWithSrcs(
+        ResVReg, ResType, I, {Extended, MaskReg},
+        IsVector ? SPIRV::OpBitwiseAndV : SPIRV::OpBitwiseAndS);
+  }
+
   unsigned Opcode = IsSigned ? SPIRV::OpSConvert : SPIRV::OpUConvert;
   return selectUnOp(ResVReg, ResType, I, Opcode);
 }
diff --git a/llvm/test/CodeGen/SPIRV/member-names.ll b/llvm/test/CodeGen/SPIRV/member-names.ll
new file mode 100644
index 0000000000..19864f7813
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/member-names.ll
@@ -0,0 +1,23 @@
+; The module's `spirv.MemberNames` metadata names a struct's members.
+
+; RUN: llc -verify-machineinstrs -O0 -mtriple=spirv-unknown-vulkan %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv-unknown-vulkan %s -o - -filetype=obj | spirv-val %}
+
+; CHECK-DAG: OpName [[light:%[0-9]+]] "Light"
+; CHECK-DAG: OpMemberName [[light]] 0 "gain"
+; CHECK-DAG: OpMemberName [[light]] 1 "colour"
+; CHECK-DAG: [[light]] = OpTypeStruct
+; CHECK-NOT: OpMemberName [[light]] 2
+%Light = type { float, <3 x float> }
+
+@light = external hidden addrspace(2) global %Light
+
+define float @gain() {
+entry:
+  %v = load %Light, ptr addrspace(2) @light
+  %g = extractvalue %Light %v, 0
+  ret float %g
+}
+
+!spirv.MemberNames = !{!0}
+!0 = !{%Light poison, !"gain", !"colour"}
diff --git a/llvm/test/CodeGen/SPIRV/signed-integers-zext.ll b/llvm/test/CodeGen/SPIRV/signed-integers-zext.ll
new file mode 100644
index 0000000000..afea060122
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/signed-integers-zext.ll
@@ -0,0 +1,57 @@
+; With `spirv.signed-integers`, a zero-extension into a signed type cannot be
+; an OpUConvert (its result must be unsigned): it sign-extends and clears the
+; bits above the source's width. A sign-extension stays an OpSConvert, and
+; without the flag a zero-extension stays an OpUConvert.
+
+; RUN: llc -verify-machineinstrs -O0 -mtriple=spirv1.6-unknown-vulkan1.3-compute %s -o - | FileCheck %s --implicit-check-not=OpUConvert
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.6-unknown-vulkan1.3-compute %s -o - -filetype=obj | spirv-val --target-env spv1.6 %}
+; RUN: sed -e '/spirv.signed-integers/d' -e 's/^!llvm.module.flags.*//' %s | llc -O0 -mtriple=spirv1.6-unknown-vulkan1.3-compute -o - | FileCheck %s --check-prefix=UNSIGNED
+
+; CHECK-DAG: [[int:%[0-9]+]] = OpTypeInt 32 1
+; CHECK-DAG: [[long:%[0-9]+]] = OpTypeInt 64 1
+; CHECK-DAG: [[short:%[0-9]+]] = OpTypeInt 16 0
+; CHECK-DAG: [[v2long:%[0-9]+]] = OpTypeVector [[long]] 2
+; CHECK-DAG: [[low32:%[0-9]+]] = OpConstant [[long]] 4294967295
+; CHECK-DAG: [[low16:%[0-9]+]] = OpConstant [[int]] 65535
+; CHECK-DAG: [[v2low32:%[0-9]+]] = OpConstantComposite [[v2long]] [[low32]] [[low32]]
+
+; CHECK-LABEL: Begin function zext32to64
+; CHECK: [[a:%[0-9]+]] = OpFunctionParameter [[int]]
+; CHECK: [[e:%[0-9]+]] = OpSConvert [[long]] [[a]]
+; CHECK: OpBitwiseAnd [[long]] [[e]] [[low32]]
+define i64 @zext32to64(i32 %a) {
+  %r = zext i32 %a to i64
+  ret i64 %r
+}
+
+; CHECK-LABEL: Begin function zext16to32
+; CHECK: [[b:%[0-9]+]] = OpFunctionParameter [[short]]
+; CHECK: [[f:%[0-9]+]] = OpSConvert [[int]] [[b]]
+; CHECK: OpBitwiseAnd [[int]] [[f]] [[low16]]
+define i32 @zext16to32(i16 %b) {
+  %r = zext i16 %b to i32
+  ret i32 %r
+}
+
+; CHECK-LABEL: Begin function zextvector
+; CHECK: [[g:%[0-9]+]] = OpSConvert [[v2long]]
+; CHECK: OpBitwiseAnd [[v2long]] [[g]] [[v2low32]]
+define <2 x i64> @zextvector(<2 x i32> %c) {
+  %r = zext <2 x i32> %c to <2 x i64>
+  ret <2 x i64> %r
+}
+
+; CHECK-LABEL: Begin function sext32to64
+; CHECK: OpSConvert [[long]]
+; CHECK-NOT: OpBitwiseAnd
+; CHECK: OpReturnValue
+define i64 @sext32to64(i32 %d) {
+  %r = sext i32 %d to i64
+  ret i64 %r
+}
+
+; UNSIGNED-COUNT-3: OpUConvert
+; UNSIGNED-NOT: OpBitwiseAnd
+
+!llvm.module.flags = !{!0}
+!0 = !{i32 1, !"spirv.signed-integers", i32 1}
diff --git a/llvm/test/CodeGen/SPIRV/signed-integers.ll b/llvm/test/CodeGen/SPIRV/signed-integers.ll
new file mode 100644
index 0000000000..b015a17ee7
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/signed-integers.ll
@@ -0,0 +1,35 @@
+; With the module flag `spirv.signed-integers`, LLVM's signless integers of 32
+; bits and more are emitted signed, and no unsigned one of those is left in
+; the module. Narrower ones stay unsigned, so their literals, written
+; zero-extended, stay valid.
+
+; RUN: llc -verify-machineinstrs -O0 -mtriple=spirv-unknown-vulkan %s -o - | FileCheck %s --implicit-check-not="OpTypeInt 32 0"
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv-unknown-vulkan %s -o - -filetype=obj | spirv-val %}
+
+; CHECK-DAG: [[int:%[0-9]+]] = OpTypeInt 32 1
+; CHECK-DAG: [[v2int:%[0-9]+]] = OpTypeVector [[int]] 2
+; CHECK-DAG: [[char:%[0-9]+]] = OpTypeInt 8 0
+; CHECK-DAG: OpConstant [[char]] 128
+; CHECK: OpLoad [[int]]
+; CHECK: OpIAdd [[int]]
+
+@n = external hidden addrspace(2) global i32
+@p = external hidden addrspace(2) global <2 x i32>
+@b = external hidden addrspace(2) global i8
+
+define i32 @read(i32 %a) {
+entry:
+  %n = load i32, ptr addrspace(2) @n
+  %p = load <2 x i32>, ptr addrspace(2) @p
+  %y = extractelement <2 x i32> %p, i32 1
+  %s = add i32 %n, %a
+  %r = sdiv i32 %s, %y
+  %b = load i8, ptr addrspace(2) @b
+  %x = xor i8 %b, -128
+  %w = sext i8 %x to i32
+  %t = add i32 %r, %w
+  ret i32 %t
+}
+
+!llvm.module.flags = !{!0}
+!0 = !{i32 1, !"spirv.signed-integers", i32 1}
-- 
