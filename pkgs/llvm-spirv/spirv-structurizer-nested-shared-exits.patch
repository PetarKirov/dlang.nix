+  br i1 %c2, label %andand, label %exit
+
+andand:
+  %c3 = fcmp ogt float %y, 1.000000e+00
+  %s = select i1 %c3, float 1.000000e+00, float 5.000000e-01
+  br label %exit
+
+exit:
+  %r = phi float [ 0.000000e+00, %oror ], [ 0.000000e+00, %entry ], [ 5.000000e-01, %endif ], [ %s, %andand ]
+  ret float %r
+}
