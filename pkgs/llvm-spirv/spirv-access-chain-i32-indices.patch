From 002841da48791390e733e3fd235453832596d4ae Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Thu, 15 Oct 2026 12:00:45 +0300
Subject: [PATCH] [SPIRV] Build logical access chains with 32-bit literal
 indices

`buildLogicalAccessChainFromGEP` turns a byte-addressing GEP back into an
access chain, and gave its literal indices an `i64` type while the leading
index is `i32`. A module with such an access chain needs the `Int64`
capability for nothing: a struct field read through an optimised GEP into
a uniform was enough, and a GLSL ES 1.00 cross-compile of the module then
fails ("64-bit integers not supported in ES profile before version 310").
Build them as `i32`, as the first index and the dynamic path's indices are.
---
 llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp |  5 ++-
 .../SPIRV/hlsl-resources/cbuffer-struct.ll    | 27 +++++++---------
 .../getelementptr-byte-addressing-array.ll    |  1 -
 ...ructured-buffer-access-constant-index-1.ll |  7 ++--
 ...ructured-buffer-access-constant-index-2.ll |  5 ++-
 .../pointers/structured-buffer-access.ll      | 32 +++++++++----------
 .../structured-buffer-vector-access.ll        | 22 ++++++-------
 7 files changed, 48 insertions(+), 51 deletions(-)

diff --git a/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp b/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp
index defc1e9322..ff7673c4e8 100644
--- a/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVEmitIntrinsics.cpp
@@ -885,8 +885,11 @@ Instruction *SPIRVEmitIntrinsicsImpl::buildLogicalAccessChainFromGEP(
   walkLogicalAccessChain(
       GEP,
       [&Indices, &B](Type *EltType, uint64_t Index) {
+        // 32-bit, as the other indices are: a struct member index must be
+        // a 32-bit constant, and an `Int64` one needs the `Int64`
+        // capability that GLSL ES 1.00 cannot express.
         Indices.push_back(
-            ConstantInt::get(B.getInt64Ty(), Index, /* Signed= */ false));
+            ConstantInt::get(B.getInt32Ty(), Index, /* Signed= */ false));
       },
       [&Indices, &B, &DL, this](Type *EltType, Value *Offset,
                                 uint64_t Multiplier) {
