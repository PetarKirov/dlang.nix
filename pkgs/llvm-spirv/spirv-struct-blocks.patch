From d8532c3282261c620e00dc1b2aed498b517439fc Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Tue, 20 Oct 2026 02:50:44 +0300
Subject: [PATCH] [SPIRV] Uniform blocks of one struct on request
 (spirv.struct-blocks)

Every Vulkan buffer's contents are wrapped in a new one-member struct
decorated Block, so a uniform block's type is unnamed and its members sit
one level below it. A module that sets `spirv.struct-blocks` gets what DXC
emits for a cbuffer instead: a uniform buffer whose contents are one struct
(or a spirv.Layout of one) makes that struct the block, its members one
access-chain index away. Other buffers, and modules without the flag, keep
the wrapper.
---
 llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp | 19 +++++++-
 llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.h   |  8 ++++
 .../Target/SPIRV/SPIRVInstructionSelector.cpp | 17 +++++---
 .../SPIRV/hlsl-resources/struct-blocks.ll     | 43 +++++++++++++++++++
 4 files changed, 79 insertions(+), 8 deletions(-)
 create mode 100644 llvm/test/CodeGen/SPIRV/hlsl-resources/struct-blocks.ll

diff --git a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
index 67eb22ce13..8a1436ac06 100644
--- a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.cpp
@@ -1684,9 +1684,20 @@ SPIRVTypeInst SPIRVGlobalRegistry::getOrCreateVulkanBufferType(
     return MI;
 
   bool ExplicitLayoutRequired = storageClassRequiresExplictLayout(SC);
+  // A module that asks for it (`spirv.struct-blocks`) makes a uniform
+  // buffer of one struct that struct, as DXC emits a cbuffer: no struct
+  // wraps it, so the block keeps the struct's name and members.
+  const auto *Flag = mdconst::extract_or_null<ConstantInt>(
+      MIRBuilder.getMF().getFunction().getParent()->getModuleFlag(
+          "spirv.struct-blocks"));
+  const auto *ElemExt = dyn_cast<TargetExtType>(ElemType);
+  const bool StructBlock = Flag && !Flag->isZero() &&
+                           SC == SPIRV::StorageClass::Uniform &&
+                           (isa<StructType>(ElemType) ||
+                            (ElemExt && ElemExt->getName() == "spirv.Layout"));
   // We need to get the SPIR-V type for the element here, so we can add the
   // decoration to it.
-  auto *T = StructType::create(ElemType);
+  Type *T = StructBlock ? ElemType : StructType::create(ElemType);
   SPIRVTypeInst BlockType =
       getOrCreateSPIRVType(T, MIRBuilder, SPIRV::AccessQualifier::None,
                            ExplicitLayoutRequired, EmitIr);
@@ -1694,8 +1705,12 @@ SPIRVTypeInst SPIRVGlobalRegistry::getOrCreateVulkanBufferType(
   buildOpDecorate(BlockType->defs().begin()->getReg(), MIRBuilder,
                   SPIRV::Decoration::Block, {});
   BlockDecoratedTypes.insert(BlockType);
+  if (StructBlock)
+    StructBlockTypes.insert(BlockType);
 
-  if (!IsWritable) {
+  // A uniform block is read-only by its storage class; a wrapper's one
+  // member is decorated so for the other storage classes.
+  if (!IsWritable && !StructBlock) {
     buildOpMemberDecorate(BlockType->defs().begin()->getReg(), MIRBuilder,
                           SPIRV::Decoration::NonWritable, 0, {});
   }
diff --git a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.h b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.h
index 83d633bfdb..0382f4736c 100644
--- a/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.h
+++ b/llvm/lib/Target/SPIRV/SPIRVGlobalRegistry.h
@@ -67,6 +67,9 @@ class SPIRVGlobalRegistry : public SPIRVIRMapping {
   // Explicitly laid-out structs whose spirv.Padding members are dropped, with
   // their LLVM type, to number a member among the others.
   DenseMap<SPIRVTypeInst, const StructType *> PaddedStructs;
+  // Uniform blocks that are their struct, with no wrapper
+  // (`spirv.struct-blocks`).
+  DenseSet<SPIRVTypeInst> StructBlockTypes;
 
   // Stores for each function the last inserted SPIR-V Type.
   // See: SPIRVGlobalRegistry::createOpType.
@@ -704,6 +707,11 @@ public:
   std::optional<unsigned> memberIndexOf(SPIRVTypeInst StructTy,
                                         unsigned Index) const;
 
+  // Whether `BlockTy` is a uniform block that is its struct, with no wrapper.
+  bool isStructBlock(SPIRVTypeInst BlockTy) const {
+    return StructBlockTypes.contains(BlockTy);
+  }
+
   // The unsigned twin of a signed integer or integer vector type, or the type
   // itself if it is not signed.
   SPIRVTypeInst getOrCreateUnsignedTwin(SPIRVTypeInst Ty,
diff --git a/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp b/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
index 4b58fe014b..75c496fcdf 100644
--- a/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
@@ -6685,22 +6685,27 @@ bool SPIRVInstructionSelector::selectResourceGetPointer(Register &ResVReg,
   assert(ResType->getOpcode() == SPIRV::OpTypePointer);
   MachineIRBuilder MIRBuilder(I);
 
-  Register ZeroReg =
-      buildZerosVal(GR.getOrCreateSPIRVIntegerType(32, I, TII), I);
+  // A block that is its struct has no wrapper to step into: its members are
+  // one index away, and its base is the block itself.
+  SPIRVTypeInst Wrapper = GR.getPointeeType(RegType);
+  const bool StructBlock = Wrapper && GR.isStructBlock(Wrapper);
+  if (StructBlock && I.getNumExplicitOperands() <= 3)
+    return BuildCOPY(ResVReg, ResourcePtr, I);
   auto MIB =
       BuildMI(*I.getParent(), I, I.getDebugLoc(), TII.get(SPIRV::OpAccessChain))
           .addDef(ResVReg)
           .addUse(GR.getSPIRVTypeID(ResType))
-          .addUse(ResourcePtr)
-          .addUse(ZeroReg);
+          .addUse(ResourcePtr);
+  if (!StructBlock)
+    MIB.addUse(buildZerosVal(GR.getOrCreateSPIRVIntegerType(32, I, TII), I));
 
   if (I.getNumExplicitOperands() > 3) {
     Register IndexReg = I.getOperand(3).getReg();
     // A member of a block whose padding members were dropped is numbered
     // among the others.
-    SPIRVTypeInst Wrapper = GR.getPointeeType(RegType);
     SPIRVTypeInst Block =
-        Wrapper && Wrapper->getOpcode() == SPIRV::OpTypeStruct
+        StructBlock ? Wrapper
+        : Wrapper && Wrapper->getOpcode() == SPIRV::OpTypeStruct
             ? GR.getSPIRVTypeForVReg(Wrapper->getOperand(1).getReg())
             : SPIRVTypeInst();
     if (Block) {
diff --git a/llvm/test/CodeGen/SPIRV/hlsl-resources/struct-blocks.ll b/llvm/test/CodeGen/SPIRV/hlsl-resources/struct-blocks.ll
new file mode 100644
index 0000000000..f4a2b40230
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/hlsl-resources/struct-blocks.ll
@@ -0,0 +1,43 @@
+; RUN: llc -O0 -verify-machineinstrs -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.6-unknown-vulkan1.3-library %s -o - -filetype=obj | spirv-val --target-env vulkan1.3 %}
+
+; With the module flag spirv.struct-blocks, a uniform buffer whose contents
+; are one struct makes that struct the block, as DXC emits a cbuffer: no
+; struct wraps it, so the block's type keeps the struct's name and members,
+; and a member is one access-chain index away.
+
+; CHECK-DAG: OpName %[[LIGHT:[0-9]+]] "Light"
+; CHECK-DAG: OpDecorate %[[LIGHT]] Block
+; CHECK-DAG: OpMemberDecorate %[[LIGHT]] 0 Offset 0
+; CHECK-DAG: OpMemberDecorate %[[LIGHT]] 1 Offset 12
+; CHECK-DAG: %[[FLOAT:[0-9]+]] = OpTypeFloat 32
+; CHECK-DAG: %[[V3:[0-9]+]] = OpTypeVector %[[FLOAT]] 3
+; CHECK-DAG: %[[LIGHT]] = OpTypeStruct %[[V3]] %[[FLOAT]]{{$}}
+; CHECK-DAG: %[[PTR:[0-9]+]] = OpTypePointer Uniform %[[LIGHT]]
+; CHECK-DAG: %[[VAR:[0-9]+]] = OpVariable %[[PTR]] Uniform
+; CHECK-DAG: %[[UINT:[0-9]+]] = OpTypeInt 32 0
+; CHECK-DAG: %[[ONE:[0-9]+]] = OpConstant %[[UINT]] 1{{$}}
+; CHECK-NOT: OpTypeStruct %[[LIGHT]]{{$}}
+; CHECK: %[[PG:[0-9]+]] = OpAccessChain %{{[0-9]+}} %{{[0-9]+}} %[[ONE]]{{$}}
+; CHECK: OpLoad %[[FLOAT]] %[[PG]]
+
+%Light = type { <3 x float>, float }
+
+@.str.u = private unnamed_addr constant [6 x i8] c"light\00", align 1
+@.str.o = private unnamed_addr constant [4 x i8] c"Out\00", align 1
+
+define void @main() #0 {
+entry:
+  %u = tail call target("spirv.VulkanBuffer", target("spirv.Layout", %Light, 16, 0, 12), 2, 0) @llvm.spv.resource.handlefrombinding.U(i32 0, i32 1, i32 1, i32 0, ptr nonnull @.str.u)
+  %pg = tail call ptr addrspace(12) @llvm.spv.resource.getpointer.p12.U(target("spirv.VulkanBuffer", target("spirv.Layout", %Light, 16, 0, 12), 2, 0) %u, i32 1)
+  %g = load float, ptr addrspace(12) %pg
+  %o = tail call target("spirv.VulkanBuffer", [0 x float], 12, 1) @llvm.spv.resource.handlefrombinding.O(i32 0, i32 2, i32 1, i32 0, ptr nonnull @.str.o)
+  %po = tail call ptr addrspace(11) @llvm.spv.resource.getpointer.p11.O(target("spirv.VulkanBuffer", [0 x float], 12, 1) %o, i32 0)
+  store float %g, ptr addrspace(11) %po
+  ret void
+}
+
+attributes #0 = { "hlsl.numthreads"="1,1,1" "hlsl.shader"="compute" }
+
+!llvm.module.flags = !{!0}
+!0 = !{i32 1, !"spirv.struct-blocks", i32 1}
-- 
