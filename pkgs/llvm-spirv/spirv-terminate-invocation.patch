From 0ee497110c47e05ad7932e1e52256ef74f3b9dc1 Mon Sep 17 00:00:00 2001
From: Petar Kirov <petar.p.kirov@gmail.com>
Date: Sat, 17 Oct 2026 11:47:10 +0300
Subject: [PATCH] [SPIRV] Add llvm.spv.terminate.invocation

GLSL's `discard` ends the invocation; HLSL's `clip`, lowered through
`llvm.spv.discard`, demotes it to a helper invocation from SPIR-V 1.6 on,
which a GLSL, MSL or SM 5 translation cannot express. A frontend whose
`discard` terminates now says so: `llvm.spv.terminate.invocation` is an
OpTerminateInvocation where SPIR-V 1.6 or SPV_KHR_terminate_invocation (now
accepted by `--spirv-ext`) provides it, and an OpKill, which means the same,
before that. Like OpKill it ends its block.

Claude-Session: https://claude.ai/code/session_01TrgPqCXtysTg54Ef5n1nm6
---
 llvm/include/llvm/IR/IntrinsicsSPIRV.td       |  4 ++
 llvm/lib/Target/SPIRV/SPIRVCommandLine.cpp    |  2 +
 llvm/lib/Target/SPIRV/SPIRVInstrInfo.td       |  1 +
 .../Target/SPIRV/SPIRVInstructionSelector.cpp | 25 ++++++++++
 llvm/lib/Target/SPIRV/SPIRVModuleAnalysis.cpp |  5 ++
 .../hlsl-intrinsics/terminate-invocation.ll   | 48 +++++++++++++++++++
 6 files changed, 85 insertions(+)
 create mode 100644 llvm/test/CodeGen/SPIRV/hlsl-intrinsics/terminate-invocation.ll

diff --git a/llvm/include/llvm/IR/IntrinsicsSPIRV.td b/llvm/include/llvm/IR/IntrinsicsSPIRV.td
index 86b49a8ee4..1fac585fda 100644
--- a/llvm/include/llvm/IR/IntrinsicsSPIRV.td
+++ b/llvm/include/llvm/IR/IntrinsicsSPIRV.td
@@ -173,6 +173,10 @@ def int_spv_rsqrt : DefaultAttrsIntrinsic<[LLVMMatchType<0>], [llvm_anyfloat_ty]
   def int_spv_group_memory_barrier_with_group_sync : ClangBuiltin<"__builtin_spirv_group_barrier">,
     DefaultAttrsIntrinsic<[], [], [IntrConvergent]>;
   def int_spv_discard : DefaultAttrsIntrinsic<[], [], []>;
+  // Ends the invocation, as GLSL's `discard` does (OpTerminateInvocation);
+  // `int_spv_discard` may instead demote it to a helper invocation.
+  def int_spv_terminate_invocation
+      : DefaultAttrsIntrinsic<[], [], [IntrNoReturn]>;
   def int_spv_ddx : DefaultAttrsIntrinsic<[llvm_anyfloat_ty], [LLVMMatchType<0>], [IntrNoMem]>;
   def int_spv_ddy : DefaultAttrsIntrinsic<[llvm_anyfloat_ty], [LLVMMatchType<0>], [IntrNoMem]>;
   def int_spv_ddx_coarse : DefaultAttrsIntrinsic<[llvm_anyfloat_ty], [LLVMMatchType<0>], [IntrNoMem]>;
diff --git a/llvm/lib/Target/SPIRV/SPIRVCommandLine.cpp b/llvm/lib/Target/SPIRV/SPIRVCommandLine.cpp
index 9563963551..23887bfd13 100644
--- a/llvm/lib/Target/SPIRV/SPIRVCommandLine.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVCommandLine.cpp
@@ -40,6 +40,8 @@ static const StringMap<SPIRV::Extension::Extension> SPIRVExtensionMap = {
      SPIRV::Extension::Extension::SPV_EXT_arithmetic_fence},
     {"SPV_EXT_demote_to_helper_invocation",
      SPIRV::Extension::Extension::SPV_EXT_demote_to_helper_invocation},
+    {"SPV_KHR_terminate_invocation",
+     SPIRV::Extension::Extension::SPV_KHR_terminate_invocation},
     {"SPV_EXT_descriptor_indexing",
      SPIRV::Extension::Extension::SPV_EXT_descriptor_indexing},
     {"SPV_EXT_fragment_fully_covered",
diff --git a/llvm/lib/Target/SPIRV/SPIRVInstrInfo.td b/llvm/lib/Target/SPIRV/SPIRVInstrInfo.td
index cd4faf80c2..bf2a0f899d 100644
--- a/llvm/lib/Target/SPIRV/SPIRVInstrInfo.td
+++ b/llvm/lib/Target/SPIRV/SPIRVInstrInfo.td
@@ -673,6 +673,7 @@ let isBarrier = 1, isTerminator = 1, isBranch = 1 in {
 }
 let isReturn = 1, hasDelaySlot = 0, isBarrier = 0, isTerminator = 1, isNotDuplicable = 1 in {
   def OpKill: SimpleOp<"OpKill", 252>;
+  def OpTerminateInvocation: SimpleOp<"OpTerminateInvocation", 4416>;
   def OpReturn: SimpleOp<"OpReturn", 253>;
   def OpReturnValue: Op<254, (outs), (ins ID:$ret), "OpReturnValue $ret">;
   def OpUnreachable: SimpleOp<"OpUnreachable", 255>;
diff --git a/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp b/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
index e7247dc30d..1b479e01ba 100644
--- a/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
@@ -229,6 +229,7 @@ private:
 
   bool selectCmp(Register ResVReg, SPIRVTypeInst ResType,
                  unsigned comparisonOpcode, MachineInstr &I) const;
+  bool selectTerminateInvocation(MachineInstr &I) const;
   bool selectDiscard(Register ResVReg, SPIRVTypeInst ResType,
                      MachineInstr &I) const;
 
@@ -4459,6 +4460,28 @@ bool SPIRVInstructionSelector::selectConcatVectors(Register ResVReg,
   return true;
 }
 
+// Ends the invocation: OpTerminateInvocation where SPIR-V 1.6 or
+// SPV_KHR_terminate_invocation provides it, else OpKill, which means the same.
+// Either ends its block, so nothing after it there is emitted.
+bool SPIRVInstructionSelector::selectTerminateInvocation(
+    MachineInstr &I) const {
+  MachineBasicBlock &BB = *I.getParent();
+  const unsigned Opcode =
+      STI.isAtLeastSPIRVVer(llvm::VersionTuple(1, 6)) ||
+              STI.canUseExtension(
+                  SPIRV::Extension::SPV_KHR_terminate_invocation)
+          ? SPIRV::OpTerminateInvocation
+          : SPIRV::OpKill;
+  for (MachineInstr &ToErase : make_early_inc_range(
+           make_range(std::next(I.getIterator()), BB.instr_end()))) {
+    GR.invalidateMachineInstr(&ToErase);
+    ToErase.eraseFromParent();
+  }
+  BuildMI(BB, I, I.getDebugLoc(), TII.get(Opcode))
+      .constrainAllUses(TII, TRI, RBI);
+  return true;
+}
+
 bool SPIRVInstructionSelector::selectDiscard(Register ResVReg,
                                              SPIRVTypeInst ResType,
                                              MachineInstr &I) const {
@@ -5854,6 +5877,8 @@ bool SPIRVInstructionSelector::selectIntrinsic(Register ResVReg,
   case Intrinsic::spv_pushconstant_getpointer: {
     return selectPushConstantGetPointer(ResVReg, ResType, I);
   }
+  case Intrinsic::spv_terminate_invocation:
+    return selectTerminateInvocation(I);
   case Intrinsic::spv_discard: {
     return selectDiscard(ResVReg, ResType, I);
   }
diff --git a/llvm/lib/Target/SPIRV/SPIRVModuleAnalysis.cpp b/llvm/lib/Target/SPIRV/SPIRVModuleAnalysis.cpp
index e49f7af126..617fd9bc36 100644
--- a/llvm/lib/Target/SPIRV/SPIRVModuleAnalysis.cpp
+++ b/llvm/lib/Target/SPIRV/SPIRVModuleAnalysis.cpp
@@ -2422,6 +2422,11 @@ void addInstrRequirements(const MachineInstr &MI,
     }
     break;
   }
+  case SPIRV::OpTerminateInvocation:
+    Reqs.addCapability(SPIRV::Capability::Shader);
+    if (!ST.isAtLeastSPIRVVer(llvm::VersionTuple(1, 6)))
+      Reqs.addExtension(SPIRV::Extension::SPV_KHR_terminate_invocation);
+    break;
   case SPIRV::OpKill: {
     Reqs.addCapability(SPIRV::Capability::Shader);
   } break;
diff --git a/llvm/test/CodeGen/SPIRV/hlsl-intrinsics/terminate-invocation.ll b/llvm/test/CodeGen/SPIRV/hlsl-intrinsics/terminate-invocation.ll
new file mode 100644
index 0000000000..eeb0904512
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/hlsl-intrinsics/terminate-invocation.ll
@@ -0,0 +1,48 @@
+; `llvm.spv.terminate.invocation` ends the invocation, as GLSL's `discard`
+; does: OpTerminateInvocation where SPIR-V 1.6 or SPV_KHR_terminate_invocation
+; provides it, and OpKill (with the same meaning) before that. Unlike
+; `llvm.spv.discard`, it never demotes to a helper invocation, and nothing
+; after it in its block is emitted.
+
+; RUN: llc -verify-machineinstrs -O0 -mtriple=spirv1.6-unknown-vulkan1.3-compute %s -o - | FileCheck %s --check-prefixes=CHECK,TERMINATE --implicit-check-not=OpExtension --implicit-check-not=OpDemoteToHelperInvocation
+; RUN: llc -verify-machineinstrs -O0 -spirv-ext=+SPV_KHR_terminate_invocation -mtriple=spirv1.5-unknown-vulkan1.2-compute %s -o - | FileCheck %s --check-prefixes=CHECK,TERMINATE,EXTENSION
+; RUN: llc -verify-machineinstrs -O0 -mtriple=spirv1.5-unknown-vulkan1.2-compute %s -o - | FileCheck %s --check-prefixes=CHECK,KILL --implicit-check-not=OpTerminateInvocation
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.6-unknown-vulkan1.3-compute %s -o - -filetype=obj | spirv-val --target-env vulkan1.3 %}
+; RUN: %if spirv-tools %{ llc -O0 -spirv-ext=+SPV_KHR_terminate_invocation -mtriple=spirv1.5-unknown-vulkan1.2-compute %s -o - -filetype=obj | spirv-val --target-env vulkan1.2 %}
+; RUN: %if spirv-tools %{ llc -O0 -mtriple=spirv1.5-unknown-vulkan1.2-compute %s -o - -filetype=obj | spirv-val --target-env vulkan1.2 %}
+
+; EXTENSION: OpExtension "SPV_KHR_terminate_invocation"
+
+; CHECK-LABEL: ; -- Begin function kill
+; CHECK:       OpBranchConditional %[[#]] %[[#yes:]] %[[#no:]]
+; CHECK:       %[[#yes]] = OpLabel
+; TERMINATE-NEXT: OpTerminateInvocation
+; KILL-NEXT:   OpKill
+; CHECK-NEXT:  %[[#no]] = OpLabel
+
+@g = internal addrspace(10) global float 0.0
+
+define internal void @kill(float %x) {
+entry:
+  %c = fcmp olt float %x, 0.000000e+00
+  br i1 %c, label %yes, label %no
+
+yes:
+  call void @llvm.spv.terminate.invocation()
+  store volatile float 1.0, ptr addrspace(10) @g, align 4
+  br label %no
+
+no:
+  ret void
+}
+
+define void @main() #0 {
+entry:
+  %x = load volatile float, ptr addrspace(10) @g, align 4
+  call void @kill(float %x)
+  ret void
+}
+
+declare void @llvm.spv.terminate.invocation()
+
+attributes #0 = { "hlsl.shader"="pixel" }
-- 
